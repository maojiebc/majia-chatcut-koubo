{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maojiebc/majia-chatcut-koubo/schemas/runtime/handoff-report.schema.json",
  "title": "User-facing review handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "runId", "timelineRevision", "deliveryState", "completed", "notPerformed", "verification", "evidence", "evidenceRefs", "openRisks", "nextActions", "generatedAt"],
  "properties": {
    "$schema": {"const": "https://github.com/maojiebc/majia-chatcut-koubo/schemas/runtime/handoff-report.schema.json"},
    "schemaVersion": {"const": "majia.koubo.handoff.v1"},
    "runId": {"type": "string", "pattern": "^run-[a-z0-9-]+$"},
    "timelineRevision": {"type": ["string", "null"], "pattern": "^rev[-_][A-Za-z0-9._-]+$"},
    "deliveryState": {"enum": ["in_progress", "blocked", "sample_ready", "review_ready", "exported"]},
    "completed": {"type": "array", "uniqueItems": true, "items": {"enum": ["project", "source-inventory", "transcript", "aroll", "sample", "smooth-audio", "captions", "visual-enhancements", "verification", "export"]}},
    "notPerformed": {"type": "array", "uniqueItems": true, "items": {"enum": ["restructure", "music", "motion-graphics", "broll", "generated-media", "export", "publish"]}},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure", "visual", "audioMeasurement", "humanListening", "sampleApproval", "finalReviewApproval", "privacy"],
      "properties": {
        "structure": {"$ref": "#/$defs/status"},
        "visual": {"$ref": "#/$defs/status"},
        "audioMeasurement": {"$ref": "#/$defs/status"},
        "humanListening": {"$ref": "#/$defs/status"},
        "sampleApproval": {"$ref": "#/$defs/status"},
        "finalReviewApproval": {"$ref": "#/$defs/status"},
        "privacy": {"$ref": "#/$defs/status"}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "kind", "hash", "revision", "provenance", "capturedAt"],
        "properties": {
          "ref": {"type": "string", "pattern": "^logical:[a-z0-9-]+$"},
          "kind": {"enum": ["structure-readback", "composed-frame", "audio-measurement", "human-listening", "sample-approval", "final-review-approval", "privacy-review"]},
          "hash": {"$ref": "run-manifest.schema.json#/$defs/hash"},
          "revision": {"type": ["string", "null"], "pattern": "^rev[-_][A-Za-z0-9._-]+$"},
          "provenance": {"enum": ["simulation", "live"]},
          "capturedAt": {"type": "string", "format": "date-time"}
        }
      }
    },
    "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^logical:[a-z0-9-]+$"}},
    "openRisks": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "nextActions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "editorHandoff": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["projectRef", "timelineRef"],
      "properties": {
        "projectRef": {"type": "string", "pattern": "^logical:[a-z0-9-]+$"},
        "timelineRef": {"type": "string", "pattern": "^logical:[a-z0-9-]+$"}
      }
    },
    "generatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "status": {"enum": ["pass", "fail", "unverified", "stale", "waived", "not_applicable", "pending"]}
  }
}
