{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maojiebc/majia-chatcut-koubo/schemas/extension-manifest.schema.json",
  "type": "object",
  "required": ["id", "name", "version", "mode", "license", "authority", "constraints"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "mode": {"enum": ["bundled", "external"]},
    "license": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "sourceRepository": {"type": "string", "format": "uri"},
    "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sourceSite": {"type": "string", "format": "uri"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "content": {"type": "object"},
    "files": {"type": "object"},
    "repository": {"type": "string", "format": "uri"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "gallery": {"type": "string", "format": "uri"},
    "libraryPath": {"type": "string", "minLength": 1},
    "allowlistPath": {"type": "string", "minLength": 1}
  }
}
