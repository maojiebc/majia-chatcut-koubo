{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maojiebc/majia-chatcut-koubo/schemas/extension-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "packs"],
  "properties": {
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mode", "manifest", "required", "purpose"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "mode": {"enum": ["bundled", "external"]},
          "manifest": {"type": "string", "pattern": "^extensions/.+/manifest\\.json$"},
          "required": {"type": "boolean"},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
